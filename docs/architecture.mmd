%% docs/architecture.mmd — this repo's own internal structure.
%% Hand-authored, not generated — companion to the fleet-wide convention in
%% ferraroroberto/fleet-config#256 (see fleet-config's own docs/architecture.mmd
%% for the dogfood example). Update this diagram in the same PR as any
%% material structural change (a module added/moved/renamed, a new external
%% dependency, a new tab). Same anti-staleness contract as this repo's own
%% `.fleet.toml` `description` field.

flowchart TB
  subgraph external["External services"]
    STRIPE["Stripe API\ncharges, fees, card country"]
    FRANKFURTER["Frankfurter API\nECB daily FX rates"]
    HUB["local-llm-hub :8000\nGemini via Anthropic SDK (default OCR path)"]
    ACCAPI["IntegraLOOP / BILOOP\nAccounting API"]
  end

  subgraph ingest["src/ — ingestion & core logic"]
    STRIPECLIENT["stripe_client.py"]
    FX["fx_rates.py"]
    CLASSIFIER["classifier.py + rules_engine.py\nactivity/geo classification,\neur_default foreign-customer warning"]
    RECLASSIFY["reclassify.py\nre-run classifier over stored rows"]
    DECLARED["declared_reports.py\nfrozen sent reports (immutable EUR amounts)"]
    OCR["invoice_ocr.py\nhub (default) or direct Gemini/Vertex fallback"]
    VENDORS["vendor_registry.py\nvendor match (folder, VAT id, name) + tax defaults"]
    ACCCLIENT["accounting_api_client.py"]
    SOCSEC["social_security.py\nbank-export cuota import"]
    DEDUPE["invoice_dedupe.py\nduplicate/receipt/out-of-period detectors + apply"]
    DB["database.py\nSQLite read/write"]
    SHARED["models.py · config.py · _json_store.py\nshared types + cached JSON config"]
    AGGEXPORT["aggregator.py + excel_exporter.py\nmonthly aggregation, regional totals + Excel report"]
  end

  subgraph taxcore["src/ — Spanish tax engine"]
    VATRULES["vat_rules.py\nactivity x geo VAT matrix, base extraction"]
    TAXENGINE["tax_engine.py\nModelo 303/130/349/347, OSS,\nEU B2C threshold, calendar"]
    SNAPSHOTCODEC["tax_snapshot_codec.py\nserialize engine output"]
    TAXVALIDATOR["tax_validator.py\ngestor-filed vs DB-computed"]
    FILEDRETURNS["filed_returns.py\nAEAT receipt PDFs -> filed boxes (pdfplumber) + CLI"]
    FIXEDASSETS["fixed_assets.py\ndepreciation (simplified table), 130 hook,\nVAT capital goods 303 30/31 + regularisation"]
  end

  subgraph localfiles["git-ignored local config"]
    VENDORSFILE["vendors.json\nvendor registry (real VAT ids)"]
  end

  subgraph storage["data/accounting.db (SQLite)"]
    DBFILE["transactions · fx_rates · invoices ·\nsocial_security_payments · quarterly_tax_entries ·\ntax_computation_snapshots · tax_audit_log ·\ndeclared_reports · declared_report_lines ·\nfiled_returns · filed_349_operators ·\nfixed_assets · fixed_asset_vat_usage"]
  end

  subgraph ui["app/ — Streamlit dashboard\n(streamlit_app.py: entry point, tab routing)"]
    LOADER["data_loader.py"]
    REPORTTABS["quarter_report · transaction_browser ·\nhistory · currency · configuration"]
    INVTABS["invoice_upload · invoice_ocr_tab · invoice_ledger ·\ninvoice_dedupe_tab · invoice_explorer · vendor_registry_tab ·\nfixed_assets_tab"]
    SSTAB["social_security_tab"]
    TAXTABS["tax_obligations · tax_validation · tax_audit"]
  end

  subgraph tests["tests/ — pytest suite"]
    TESTFILES["test_classifier · test_database · test_fx_rates ·\ntest_aggregator · test_rules_engine · test_models ·\ntest_tax_engine · test_tax_validator · test_social_security ·\ntest_invoice_ledger · test_invoice_ledger_tab · test_stripe_eu_b2c_reclassify ·\ntest_filed_returns · test_invoice_dedupe · test_invoice_dedupe_tab ·\ntest_vendor_registry · test_vendor_registry_tab · test_fixed_assets"]
  end

  subgraph scripts["scripts/ — operational tooling"]
    CLOSEQ["close_quarter.py\ninvoice sweep + Stripe fetch + reclassify +\nExcel report (+ freeze)\n(driven by /close-quarter skill, outputs to tmp/, git-ignored)"]
  end

