%% docs/architecture.mmd — this repo's own internal structure.
%% Hand-authored, not generated — companion to the fleet-wide convention in
%% ferraroroberto/fleet-config#256 (see fleet-config's own docs/architecture.mmd
%% for the dogfood example). Update this diagram in the same PR as any
%% material structural change (a module added/moved/renamed, a new external
%% dependency, a new tab). Same anti-staleness contract as this repo's own
%% `.fleet.toml` `description` field.

flowchart TB
  subgraph external["External services"]
    STRIPE["Stripe API\ncharges, fees, card country"]
    FRANKFURTER["Frankfurter API\nECB daily FX rates"]
    HUB["local-llm-hub :8000\nGemini via Anthropic SDK (sole OCR path)"]
    ACCAPI["IntegraLOOP / BILOOP\nAccounting API"]
  end

  subgraph ingest["src/ — ingestion & core logic"]
    STRIPECLIENT["stripe_client.py"]
    FX["fx_rates.py"]
    CLASSIFIER["classifier.py + rules_engine.py\nactivity/geo classification,\neur_default foreign-customer warning"]
    RECLASSIFY["reclassify.py\nre-run classifier over stored rows"]
    DECLARED["declared_reports.py\nfrozen sent reports (immutable EUR amounts)"]
    OCR["invoice_ocr.py\nlocal-llm-hub only (gemini_pro alias)"]
    INGEST["invoice_ingest.py\nOCR -> FX -> vendor registry -> DB save path\n(hash-based new/changed detection)"]
    PAYMENTSLOADER["payments_loader.py\nperiod loading, FX conversion, classification\n(CLI-facing; app/data_loader.py adds @st.cache_data)"]
    SCANNER["invoice_scanner.py\ninvoice folder resolution + recursive PDF scan"]
    RELINK["relink.py\nre-point invoice records after PDFs move or rename\n(move record, then content hash; unmatched/ambiguous reported)"]
    PIPELINE["close_pipeline.py\nquarter-close steps: sweep, ocr, vendors, dedupe, fx,\nstripe, reta, compute, reconcile, sheet, gestor pack, archive\n(idempotent, each reports its changes)"]
    VENDORS["vendor_registry.py\nvendor match (folder, VAT id, name) + tax defaults"]
    ACCCLIENT["accounting_api_client.py"]
    SOCSEC["social_security.py\nbank-export cuota import"]
    DEDUPE["invoice_dedupe.py\nduplicate/receipt/out-of-period detectors + apply"]
    DB["database.py\nSQLite read/write"]
    SHARED["models.py · config.py · _json_store.py\nshared types + cached JSON config"]
    AGGEXPORT["aggregator.py + excel_exporter.py\nmonthly aggregation, regional totals + Excel report"]
  end

  subgraph taxcore["src/ — Spanish tax engine"]
    VATRULES["vat_rules.py\nactivity x geo VAT matrix, base extraction"]
    TAXENGINE["tax_engine.py\nModelo 303 (AEAT boxes, pro-rata, credit chain),\n130 (AEAT boxes, 13 reduction, 15 carry),\n349/347, OSS, EU B2C threshold, calendar"]
    TAXMODELS["tax_models.py\nresult dataclasses named after the AEAT boxes\n(aeat_boxes() / operators()), OSS rates"]
    PERIODS["periods.py\nquarter bounds (date / ISO / datetime)"]
    TAXCODES["tax_codes.py\nEU VAT prefixes, NIF→geo, tax_treatment values and mappings"]
    TAXDATA["tax_data.py\nconfig plumbing, record loaders, activity-start floor, per-row VAT figures"]
    SNAPSHOTCODEC["tax_snapshot_codec.py\nserialize engine output"]
    TAXVALIDATOR["tax_validator.py\nfiled-return loader (receipts, yaml fallback)"]
    FILEDRETURNS["filed_returns.py\nAEAT receipt PDFs -> filed boxes (pdfplumber) + CLI"]
    FIXEDASSETS["fixed_assets.py\ndepreciation (simplified table), 130 hook,\nVAT capital goods 303 30/31 + regularisation"]
    RECONCILIATION["reconciliation.py\nfiled vs app per AEAT box + 349 operators,\ndivergence catalogue, markdown export"]
    TAXDEADLINES["tax_deadlines.py
filing / direct-debit deadlines, business-day rules,
shared by the filing sheet and the Obligations calendar"]
    FILINGSHEET["filing_sheet.py\nfiling sheet: AEAT form order, credit chain,\ndeadlines (direct debit / filing), mark filed\n(immutable FILED snapshot versions)"]
    MODELO390["modelo_390.py\nModelo 390 from the four 303 results\n(per-rate rows, pro-rata, compensation, volume)"]
    ANNUALPACK["annual_pack.py + modelo_347.py + pl_by_activity.py\n347 purchases, P&L per IAE activity (ties to 130 Q4),\nmarkdown/CSV export + CLI"]
  end

  subgraph localfiles["git-ignored local config"]
    VENDORSFILE["vendors.json\nvendor registry (real VAT ids)"]
    DIVERGENCESFILE["divergences.json\ndivergence catalogue"]
  end

  subgraph storage["data/accounting.db (SQLite)"]
    DBFILE["transactions · fx_rates · fx_exchange_differences · invoices ·\nsocial_security_payments · quarterly_tax_entries ·\ntax_computation_snapshots · tax_audit_log ·\ndeclared_reports · declared_report_lines ·\nfiled_returns · filed_349_operators ·\nfixed_assets · fixed_asset_vat_usage"]
  end

  subgraph ui["app/ — Streamlit dashboard\n(streamlit_app.py: entry point, tab routing)"]
    LOADER["data_loader.py"]
    UIHELPERS["flash.py (messages that survive st.rerun) ·\nexcel_download.py (shared Excel export) ·\nyear_picker.py (one year range for every picker)"]
    REPORTTABS["quarter_report · transaction_browser ·\nhistory · currency · configuration"]
    INVTABS["invoice_upload · invoice_ocr_tab (FX resolution at ingestion) ·\ninvoice_ledger (exchange differences form) ·\ninvoice_dedupe_tab · invoice_explorer · vendor_registry_tab ·\nfixed_assets_tab"]
    SSTAB["social_security_tab"]
    TAXTABS["tax_obligations (+ annual_pack_tab) · filing_sheet_tab ·\ntax_validation (Reconciliation) · tax_audit"]
  end

  subgraph tests["tests/ — pytest suite"]
    TESTFILES["test_classifier · test_database · test_fx_rates ·\ntest_aggregator · test_rules_engine · test_models ·\ntest_tax_engine · test_social_security ·\ntest_invoice_ledger · test_invoice_ledger_tab · test_stripe_eu_b2c_reclassify ·\ntest_filed_returns · test_invoice_dedupe · test_invoice_dedupe_tab ·\ntest_vendor_registry · test_vendor_registry_tab · test_fixed_assets ·\ntest_invoice_fx · test_reconciliation · test_tax_validation_tab ·\ntest_modelo_303 · test_modelo_130 · test_close_pipeline ·\ntest_invoice_ocr_tab · test_audit163_fixes · test_modelo_349 · test_filing_sheet ·\ntest_filing_sheet_tab · test_annual_pack · test_stripe_client ·\ntest_relink"]
  end

  subgraph scripts["scripts/ — operational tooling"]
    CLOSEQ["close_quarter.py\nthin CLI over close_pipeline.py (+ all) and the\nstripe-fetch / reclassify / report (+ freeze) / freeze-sent / fx helpers\n(driven by /close-quarter skill, outputs to tmp/, git-ignored)"]
  end

